# Client-safe values for the separate CAP Mastery Supabase project.
# Obtain these from Supabase Project Settings > API only after Checkpoint 2 begins.
EXPO_PUBLIC_SUPABASE_URL=https://your-cap-mastery-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-cap-mastery-publishable-key

# Never add SUPABASE_SERVICE_ROLE_KEY or a database password to this client env file.
