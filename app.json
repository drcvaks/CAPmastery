{
  "expo": {
    "name": "CAP Mastery",
    "slug": "cap-mastery",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "capmastery",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.chaimvaks.capmastery",
      "adaptiveIcon": {
        "backgroundColor": "#102A43"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-status-bar", "expo-font"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "40186af9-064b-4d2f-acb8-aab2bd12a323"
      }
    },
    "owner": "chaimvaks"
  }
}
