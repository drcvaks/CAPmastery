{
  "expo": {
    "name": "CAP Mastery",
    "slug": "cap-mastery",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "capmastery",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.chaimvaks.capmastery",
      "adaptiveIcon": {
        "backgroundColor": "#102A43"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-status-bar", "expo-font"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
